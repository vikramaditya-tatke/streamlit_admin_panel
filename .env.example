CLICKHOUSE_BASE_URL=localhost
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Use the HTTP interface, not the native TCP port.
# For local HTTP: set CLICKHOUSE_PORT=8123 and CLICKHOUSE_SECURE=false.
CLICKHOUSE_PORT=8443
CLICKHOUSE_SECURE=true
CLICKHOUSE_COMPRESSION_PROTOCOL=lz4
CLICKHOUSE_BATCH_SIZE=10000
